# Obsidian: per-person window layout and caches (cause merge conflicts)
.obsidian/workspace*
.obsidian/cache
.trash/

# Secrets: never commit API keys
.env
.env.*
*.key

# Python/Node leftovers
# (app/raw/ is committed on purpose: it is the PSI snapshot every number traces back to)
__pycache__/
*.pyc
.venv/
node_modules/

# Editor settings (per person)
.idea/
.vscode/

# OS files
Thumbs.db
.DS_Store
